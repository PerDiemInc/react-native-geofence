{
	"name": "@perdieminc/react-native-geofence",
	"version": "0.1.0",
	"description": "Register places with a notification. The OS watches them and shows the notification when the device arrives, even with the app closed.",
	"keywords": [
		"react-native",
		"ios",
		"android",
		"geofence",
		"geofencing",
		"region-monitoring",
		"local-notification",
		"turbomodule"
	],
	"license": "MIT",
	"author": "Per Diem Subscriptions Inc.",
	"homepage": "https://github.com/PerDiemInc/react-native-geofence#readme",
	"bugs": {
		"url": "https://github.com/PerDiemInc/react-native-geofence/issues"
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"react-native": "src/index.ts",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PerDiemInc/react-native-geofence.git"
	},
	"scripts": {
		"lint": "biome lint .",
		"format": "biome check --write .",
		"clean": "rm -rf lib coverage tsconfig.tsbuildinfo",
		"build": "tsc -b .",
		"build:watch": "tsc --watch",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run clean && npm run build && npm test"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@react-native/babel-preset": "0.84.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.0",
		"jest": "^30.2.0",
		"react": "19.2.3",
		"react-native": "0.84.1",
		"typescript": "^5.9.3"
	},
	"files": [
		"lib",
		"src",
		"ios",
		"android",
		"perdiem-react-native-geofence.podspec",
		"!android/build",
		"!**/.DS_Store"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"react-native": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"codegenConfig": {
		"name": "RNPerdiemGeofence",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.perdiem.geofence"
		}
	}
}
